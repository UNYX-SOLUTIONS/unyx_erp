{
  "name": "unyx-erp",
  "version": "0.1.0",
  "private": true,
  "description": "Unyx ERP - Sistema de planificación de recursos empresariales",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "node scripts/ensure-deps.mjs && pnpm -r --parallel dev",
    "dev:frontend": "node scripts/ensure-deps.mjs && pnpm --filter frontend dev",
    "dev:backend": "node scripts/ensure-deps.mjs && pnpm --filter backend dev",
    "build": "node scripts/ensure-deps.mjs && pnpm -r build",
    "build:frontend": "pnpm --filter frontend build",
    "build:backend": "pnpm --filter backend build",
    "start": "pnpm -r start",
    "lint": "pnpm -r lint",
    "type-check": "pnpm -r type-check",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "db:generate": "pnpm --filter backend prisma:generate",
    "db:migrate": "pnpm --filter backend prisma:migrate",
    "db:seed": "pnpm --filter backend prisma:seed",
    "db:studio": "pnpm --filter backend prisma:studio",
    "clean": "rimraf node_modules backend/node_modules frontend/node_modules backend/dist frontend/.next"
  },
  "devDependencies": {
    "prettier": "3.2.5",
    "rimraf": "5.0.7",
    "typescript": "5.4.5"
  }
}
