# === Unyx ERP — variables de producción ===
# Copiar este archivo como .env.production en el VPS (/opt/unyx-erp/.env.production)
# y ajustar los valores reales. NUNCA subir .env.production al repositorio.

# Dominio público (sin https://). Debe apuntar por DNS al VPS y estar configurado en Traefik.
UNYX_DOMAIN=unyx-erp.example.com

POSTGRES_USER=unyx
POSTGRES_PASSWORD=CAMBIA_ESTA_CLAVE
POSTGRES_DB=unyx_erp

# Conexión a la base de datos de Altosa (SOLO LECTURA, usada por el ETL de importación).
# Ajustar según el acceso definido (VPN, túnel SSH o IP whitelisted):
# DATABASE_URL_ALTOSA=postgresql://usuario_ro:clave@IP_O_HOST_ALTOSA:5432/altosa_db?schema=public
DATABASE_URL_ALTOSA=postgresql://usuario_ro:clave@IP_O_HOST_ALTOSA:5432/altosa_db?schema=public

JWT_ACCESS_SECRET=CAMBIA_ESTO_POR_UN_SECRETO_LARGO
JWT_REFRESH_SECRET=CAMBIA_ESTO_POR_OTRO_SECRETO_LARGO
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# altosa-api (lectura + sincronización de productos). Debe ser alcanzable desde el backend.
ALTOSA_API_URL=https://api.altosamobiliario.com
ALTOSA_API_KEY=CAMBIA_POR_LA_API_KEY_DE_ALTOSA

# Contifico (fuente de verdad del inventario).
CONTIFICO_API_URL=https://api.contifico.com/sistema/api/v1
CONTIFICO_API_KEY=CAMBIA_POR_LA_API_KEY_DE_CONTIFICO
CONTIFICO_API_TOKEN=CAMBIA_POR_EL_POS_TOKEN_DE_CONTIFICO
