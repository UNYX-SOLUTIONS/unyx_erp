# === Unyx ERP — variables de producción ===
# Copiar este archivo como .env.production en el VPS (/opt/unyx-erp/.env.production)
# y ajustar los valores reales. NUNCA subir .env.production al repositorio.

# Dominio público (sin https://). Debe apuntar por DNS al VPS y estar configurado en Traefik.
UNYX_DOMAIN=ejemploaltosa.com

POSTGRES_USER=unyx
POSTGRES_PASSWORD=CAMBIA_ESTA_CLAVE
POSTGRES_DB=unyx_erp

# Conexión directa a la base de Altosa (SOLO para el ETL legado).
# El sync Contifico -> Altosa usa ALTOSA_API_URL (API), no esta conexión.
# Si no usas el ETL, puedes dejar el placeholder; el deploy emitirá un aviso.
#DATABASE_URL_ALTOSA=postgresql://User:TU_PASSWORD@ejemplo.com:5432/altosa?schema=public

JWT_ACCESS_SECRET=CAMBIA_ESTO_POR_UN_SECRETO_LARGO
JWT_REFRESH_SECRET=CAMBIA_ESTO_POR_OTRO_SECRETO_LARGO
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# altosa-api: URL pública de la API en su VPS (Traefik) y la MISMA clave
# configurada en altosa_infrastructure/.env como ALTOSA_API_KEY.
ALTOSA_API_URL=https://api.altosamobiliario.com/
ALTOSA_API_KEY=EjemploDeApiKeyDeAltosa

# Contifico/Meta/Kommo viven en altosa_infrastructure. El ERP ya no usa
# CONTIFICO_API_KEY ni tokens externos; solo ALTOSA_API_KEY.

# Opcional: solo si ejecutas deploy-prod.sh --seed.
SEED_ADMIN_PASSWORD=CAMBIA_POR_UNA_CLAVE_FUERTE
