# Variables SOLO para desarrollo local (`pnpm dev` desde backend/).
# En Docker/VPS se usa /opt/unyx-erp/.env.production; este archivo no se copia
# a la imagen ni se sube con deploy-prod.ps1.
NODE_ENV=development
PORT=4001
DATABASE_URL=postgresql://unyx:unyx_pass@localhost:5435/unyx_erp?schema=public
DATABASE_URL_ALTOSA=postgresql://unyx:unyx_pass@localhost:5435/unyx_erp?schema=public
JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
CORS_ORIGIN=http://localhost:3000
TRUST_PROXY=false
# API interna de Altosa (servicio-a-servicio). En el VPS: http://altosa-api:4100
# y la misma ALTOSA_API_KEY configurada en altosa_infrastructure/.env
ALTOSA_API_URL=http://localhost:4100
ALTOSA_API_KEY=change_me_altosa_api_key

# Contifico/Meta/Kommo viven en altosa_infrastructure. El ERP no guarda
# tokens de esas integraciones; solo usa ALTOSA_API_KEY.
