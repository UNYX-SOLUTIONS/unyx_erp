NODE_ENV=development
PORT=4001
DATABASE_URL=postgresql://unyx:unyx_pass@localhost:5435/unyx_erp?schema=public
DATABASE_URL_ALTOSA=postgresql://unyx:unyx_pass@localhost:5435/unyx_erp?schema=public
JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
CORS_ORIGIN=http://localhost:3000
TRUST_PROXY=false
# API interna de Altosa (servicio-a-servicio). En el VPS: http://altosa-api:4100
# y la misma ALTOSA_API_KEY configurada en altosa_infrastructure/.env
ALTOSA_API_URL=http://localhost:4100
ALTOSA_API_KEY=change_me_altosa_api_key

# Integración Contifico (inventario = fuente de verdad).
# La API key se envía en el header Authorization (raw, sin "Bearer").
# El API token/POS token es opcional y solo se usa en endpoints POS.
CONTIFICO_API_URL=https://api.contifico.com/sistema/api/v2
CONTIFICO_API_KEY=change_me_contifico_api_key
CONTIFICO_API_TOKEN=change_me_contifico_api_token
