generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id        String   @id @default(cuid())
  name      String
  legalName String?
  taxId     String?  @unique
  email     String?
  phone     String?
  address   String?
  logoUrl   String?
  currency  String   @default("USD")
  timezone  String   @default("America/Guayaquil")
  locale    String   @default("es-EC")
  isActive  Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  branches    Branch[]
  warehouses  Warehouse[]
  users       User[]
  roles       Role[]
  products    Product[]
  categories  Category[]
  customers   Customer[]
  suppliers   Supplier[]
  sales       Sale[]
  purchases   PurchaseOrder[]
  accounts    Account[]
  departments Department[]
  employees   Employee[]
  auditLogs   AuditLog[]

  @@index([taxId])
  @@index([isActive])
  @@map("companies")
}

model Branch {
  id        String   @id @default(cuid())
  companyId String
  code      String
  name      String
  address   String?
  phone     String?
  email     String?
  isActive  Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  warehouses Warehouse[]
  users      User[]
  sales      Sale[]
  purchases  PurchaseOrder[]
  employees  Employee[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("branches")
}

model Warehouse {
  id        String   @id @default(cuid())
  companyId String
  branchId  String
  code      String
  name      String
  address   String?
  isActive  Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  company       Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch        Branch              @relation(fields: [branchId], references: [id], onDelete: Cascade)
  stocks        Stock[]
  movements     StockMovement[]
  saleItems     SaleItem[]
  purchaseItems PurchaseOrderItem[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([branchId])
  @@map("warehouses")
}

model User {
  id             String    @id @default(cuid())
  companyId      String
  branchId       String?
  email          String    @unique
  username       String    @unique
  passwordHash   String
  firstName      String
  lastName       String
  avatarUrl      String?
  phone          String?
  isActive       Boolean   @default(true)
  isSuperAdmin   Boolean   @default(false)
  emailVerified  Boolean   @default(false)
  lastLoginAt    DateTime?
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch    Branch?    @relation(fields: [branchId], references: [id])
  roles     UserRole[]
  sessions  Session[]
  auditLogs AuditLog[]

  @@index([companyId])
  @@index([email])
  @@map("users")
}

model Role {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  description String?
  isSystem    Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company     Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  users       UserRole[]
  permissions RolePermission[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  code        String   @unique
  module      String
  action      String
  description String?

  createdAt DateTime @default(now())

  roles RolePermission[]

  @@index([module])
  @@map("permissions")
}

model UserRole {
  userId String
  roleId String

  assignedAt DateTime @default(now())
  assignedBy String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Session {
  id           String    @id @default(cuid())
  userId       String
  refreshToken String    @unique
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshToken])
  @@map("sessions")
}

model AuditLog {
  id        String   @id @default(cuid())
  companyId String
  userId    String?
  action    String
  entity    String
  entityId  String?
  oldValues Json?
  newValues Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id])

  @@index([companyId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Category {
  id          String   @id @default(cuid())
  companyId   String
  parentId    String?
  name        String
  slug        String
  description String?
  isActive    Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  company  Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@unique([companyId, slug])
  @@index([companyId])
  @@map("categories")
}

model Unit {
  id        String  @id @default(cuid())
  companyId String
  code      String
  name      String
  isActive  Boolean @default(true)

  products Product[]

  @@unique([companyId, code])
  @@map("units")
}

model Tax {
  id        String  @id @default(cuid())
  companyId String
  name      String
  rate      Decimal @db.Decimal(5, 2)
  isActive  Boolean @default(true)

  products      Product[]
  saleItems     SaleItem[]
  purchaseItems PurchaseOrderItem[]

  @@index([companyId])
  @@map("taxes")
}

model Brand {
  id        String  @id @default(cuid())
  companyId String
  name      String
  isActive  Boolean @default(true)

  products Product[]

  @@unique([companyId, name])
  @@map("brands")
}

model Product {
  id          String   @id @default(cuid())
  companyId   String
  sku         String
  barcode     String?
  name        String
  description String?
  categoryId  String?
  brandId     String?
  unitId      String?
  taxId       String?
  costPrice   Decimal  @default(0) @db.Decimal(14, 4)
  salePrice   Decimal  @default(0) @db.Decimal(14, 4)
  minStock    Decimal  @default(0) @db.Decimal(14, 4)
  maxStock    Decimal  @default(0) @db.Decimal(14, 4)
  imageUrl    String?
  isActive    Boolean  @default(true)
  isService   Boolean  @default(false)
  trackStock  Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  company       Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category      Category?           @relation(fields: [categoryId], references: [id])
  brand         Brand?              @relation(fields: [brandId], references: [id])
  unit          Unit?               @relation(fields: [unitId], references: [id])
  tax           Tax?                @relation(fields: [taxId], references: [id])
  variants      ProductVariant[]
  stocks        Stock[]
  movements     StockMovement[]
  saleItems     SaleItem[]
  purchaseItems PurchaseOrderItem[]

  @@unique([companyId, sku])
  @@index([companyId])
  @@index([barcode])
  @@map("products")
}

model ProductVariant {
  id         String   @id @default(cuid())
  productId  String
  sku        String
  name       String
  attributes Json?
  costPrice  Decimal  @default(0) @db.Decimal(14, 4)
  salePrice  Decimal  @default(0) @db.Decimal(14, 4)
  barcode    String?
  isActive   Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  stocks    Stock[]
  movements StockMovement[]

  @@unique([productId, sku])
  @@index([productId])
  @@map("product_variants")
}

model Stock {
  id          String   @id @default(cuid())
  productId   String
  variantId   String?
  warehouseId String
  quantity    Decimal  @default(0) @db.Decimal(14, 4)
  reserved    Decimal  @default(0) @db.Decimal(14, 4)
  updatedAt   DateTime @updatedAt

  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  warehouse Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([productId, variantId, warehouseId])
  @@index([warehouseId])
  @@map("stocks")
}

enum MovementType {
  IN
  OUT
  ADJUSTMENT
  TRANSFER
  RETURN
}

model StockMovement {
  id            String       @id @default(cuid())
  productId     String
  variantId     String?
  warehouseId   String
  type          MovementType
  quantity      Decimal      @db.Decimal(14, 4)
  previousStock Decimal      @db.Decimal(14, 4)
  newStock      Decimal      @db.Decimal(14, 4)
  reference     String?
  referenceId   String?
  notes         String?
  createdById   String?
  createdAt     DateTime     @default(now())

  product   Product         @relation(fields: [productId], references: [id])
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  warehouse Warehouse       @relation(fields: [warehouseId], references: [id])

  @@index([productId])
  @@index([warehouseId])
  @@index([createdAt])
  @@map("stock_movements")
}

model Customer {
  id          String   @id @default(cuid())
  companyId   String
  code        String
  name        String
  legalName   String?
  taxId       String?
  email       String?
  phone       String?
  address     String?
  city        String?
  country     String   @default("EC")
  creditLimit Decimal  @default(0) @db.Decimal(14, 2)
  isActive    Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sales   Sale[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([taxId])
  @@map("customers")
}

model Supplier {
  id        String   @id @default(cuid())
  companyId String
  code      String
  name      String
  legalName String?
  taxId     String?
  email     String?
  phone     String?
  address   String?
  city      String?
  country   String   @default("EC")
  isActive  Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  company   Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  purchases PurchaseOrder[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("suppliers")
}

enum PurchaseStatus {
  DRAFT
  SENT
  PARTIAL
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id          String         @id @default(cuid())
  companyId   String
  branchId    String?
  supplierId  String
  number      String
  status      PurchaseStatus @default(DRAFT)
  orderDate   DateTime       @default(now())
  expectedAt  DateTime?
  subtotal    Decimal        @default(0) @db.Decimal(14, 2)
  taxTotal    Decimal        @default(0) @db.Decimal(14, 2)
  total       Decimal        @default(0) @db.Decimal(14, 2)
  notes       String?
  createdById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  company  Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch   Branch?             @relation(fields: [branchId], references: [id])
  supplier Supplier            @relation(fields: [supplierId], references: [id])
  items    PurchaseOrderItem[]
  receipts GoodsReceipt[]

  @@unique([companyId, number])
  @@index([companyId])
  @@index([supplierId])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String   @id @default(cuid())
  purchaseOrderId String
  productId       String
  warehouseId     String?
  taxId           String?
  description     String?
  quantity        Decimal  @db.Decimal(14, 4)
  receivedQty     Decimal  @default(0) @db.Decimal(14, 4)
  unitPrice       Decimal  @db.Decimal(14, 4)
  discount        Decimal  @default(0) @db.Decimal(14, 2)
  taxRate         Decimal  @default(0) @db.Decimal(5, 2)
  taxAmount       Decimal  @default(0) @db.Decimal(14, 2)
  subtotal        Decimal  @db.Decimal(14, 2)
  total           Decimal  @db.Decimal(14, 2)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id])
  warehouse     Warehouse?    @relation(fields: [warehouseId], references: [id])
  tax           Tax?          @relation(fields: [taxId], references: [id])

  @@index([purchaseOrderId])
  @@map("purchase_order_items")
}

model GoodsReceipt {
  id              String   @id @default(cuid())
  purchaseOrderId String
  number          String
  receivedAt      DateTime @default(now())
  notes           String?
  createdById     String?

  createdAt DateTime @default(now())

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@index([purchaseOrderId])
  @@map("goods_receipts")
}

enum SaleStatus {
  DRAFT
  CONFIRMED
  PAID
  PARTIAL
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  CHECK
  CREDIT
  OTHER
}

model Sale {
  id            String     @id @default(cuid())
  companyId     String
  branchId      String?
  customerId    String?
  number        String
  status        SaleStatus @default(DRAFT)
  saleDate      DateTime   @default(now())
  subtotal      Decimal    @default(0) @db.Decimal(14, 2)
  discountTotal Decimal    @default(0) @db.Decimal(14, 2)
  taxTotal      Decimal    @default(0) @db.Decimal(14, 2)
  total         Decimal    @default(0) @db.Decimal(14, 2)
  paidTotal     Decimal    @default(0) @db.Decimal(14, 2)
  balance       Decimal    @default(0) @db.Decimal(14, 2)
  notes         String?
  createdById   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch   Branch?   @relation(fields: [branchId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])
  items    SaleItem[]
  payments Payment[]
  invoices Invoice[]

  @@unique([companyId, number])
  @@index([companyId])
  @@index([customerId])
  @@index([saleDate])
  @@map("sales")
}

model SaleItem {
  id          String   @id @default(cuid())
  saleId      String
  productId   String
  warehouseId String?
  taxId       String?
  description String?
  quantity    Decimal  @db.Decimal(14, 4)
  unitPrice   Decimal  @db.Decimal(14, 4)
  discount    Decimal  @default(0) @db.Decimal(14, 2)
  taxRate     Decimal  @default(0) @db.Decimal(5, 2)
  taxAmount   Decimal  @default(0) @db.Decimal(14, 2)
  subtotal    Decimal  @db.Decimal(14, 2)
  total       Decimal  @db.Decimal(14, 2)

  sale      Sale       @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product   Product    @relation(fields: [productId], references: [id])
  warehouse Warehouse? @relation(fields: [warehouseId], references: [id])
  tax       Tax?       @relation(fields: [taxId], references: [id])

  @@index([saleId])
  @@map("sale_items")
}

model Payment {
  id          String        @id @default(cuid())
  saleId      String
  method      PaymentMethod
  amount      Decimal       @db.Decimal(14, 2)
  reference   String?
  paidAt      DateTime      @default(now())
  notes       String?
  createdById String?

  createdAt DateTime @default(now())

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@map("payments")
}

model Invoice {
  id            String   @id @default(cuid())
  saleId        String
  number        String
  authorization String?
  issuedAt      DateTime @default(now())
  dueAt         DateTime?
  pdfUrl        String?
  xmlUrl        String?
  status        String   @default("ISSUED")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@unique([saleId, number])
  @@index([saleId])
  @@map("invoices")
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

model Account {
  id        String      @id @default(cuid())
  companyId String
  code      String
  name      String
  type      AccountType
  parentId  String?
  isActive  Boolean     @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent   Account?      @relation("AccountTree", fields: [parentId], references: [id])
  children Account[]     @relation("AccountTree")
  lines    JournalLine[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("accounts")
}

model JournalEntry {
  id          String   @id @default(cuid())
  companyId   String
  number      String
  date        DateTime
  description String?
  reference   String?
  isPosted    Boolean  @default(false)
  createdById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines JournalLine[]

  @@unique([companyId, number])
  @@index([companyId])
  @@index([date])
  @@map("journal_entries")
}

model JournalLine {
  id             String  @id @default(cuid())
  journalEntryId String
  accountId      String
  debit          Decimal @default(0) @db.Decimal(14, 2)
  credit         Decimal @default(0) @db.Decimal(14, 2)
  description    String?

  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account      Account      @relation(fields: [accountId], references: [id])

  @@index([journalEntryId])
  @@index([accountId])
  @@map("journal_lines")
}

model Department {
  id        String  @id @default(cuid())
  companyId String
  name      String
  code      String?
  isActive  Boolean @default(true)

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  positions Position[]
  employees Employee[]

  @@unique([companyId, name])
  @@map("departments")
}

model Position {
  id           String  @id @default(cuid())
  departmentId String
  name         String
  description  String?
  baseSalary   Decimal @default(0) @db.Decimal(14, 2)
  isActive     Boolean @default(true)

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  employees  Employee[]

  @@map("positions")
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
  TERMINATED
}

model Employee {
  id           String         @id @default(cuid())
  companyId    String
  branchId     String?
  departmentId String?
  positionId   String?
  code         String
  firstName    String
  lastName     String
  email        String?
  phone        String?
  hireDate     DateTime
  endDate      DateTime?
  salary       Decimal        @db.Decimal(14, 2)
  status       EmployeeStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  company    Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch     Branch?      @relation(fields: [branchId], references: [id])
  department Department?  @relation(fields: [departmentId], references: [id])
  position   Position?    @relation(fields: [positionId], references: [id])
  attendances Attendance[]
  payrolls   Payroll[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("employees")
}

model Attendance {
  id          String    @id @default(cuid())
  employeeId  String
  date        DateTime
  checkIn     DateTime?
  checkOut    DateTime?
  hoursWorked Decimal?  @db.Decimal(6, 2)
  notes       String?

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
  @@map("attendances")
}

model Payroll {
  id          String    @id @default(cuid())
  employeeId  String
  periodStart DateTime
  periodEnd   DateTime
  grossSalary Decimal   @db.Decimal(14, 2)
  deductions  Decimal   @default(0) @db.Decimal(14, 2)
  bonuses     Decimal   @default(0) @db.Decimal(14, 2)
  netSalary   Decimal   @db.Decimal(14, 2)
  paidAt      DateTime?
  notes       String?

  createdAt DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("payrolls")
}